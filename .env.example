# SS ERP 环境变量样例
# 复制为 .env 后修改值。生产环境请用 .env.production.example 作为基准。
# 字段按代码实际读取整理，未列出的字段不会被代码使用。

# ===== 数据库（必填） =====
DATABASE_URL="postgresql://user:password@localhost:5432/ss_erp"

# ===== Redis / 队列（推荐） =====
# 默认连接 redis://localhost:6379；生产短信验证码、登录失败计数和 BullMQ worker 依赖 Redis
# 本地开发如需禁用 Redis，设置 REDIS_DISABLED=1（注册短信验证码不可用）
REDIS_URL="redis://localhost:6379"
REDIS_DISABLED="0"

# ===== 加密密钥（生产必填，开发可留空，长度 ≥32） =====
# 用于加密店铺 API Key
ENCRYPTION_KEY=""

# ===== JWT（生产必填，开发可留空，长度 ≥16） =====
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
SESSION_TTL_SECONDS="604800"
# 扩展认证迁移模式：compat 保留旧 Token；device-only 仅允许设备配对。
EXTENSION_AUTH_MODE="compat"
# 中央物流规则分发开关；启用后生产环境会强制校验下列独立设备认证配置。
LOGISTICS_DISTRIBUTION_ENABLED="false"
# 优先从 Ozon Global Calculator 实时校验 Official 地址目录。
OZON_GLOBAL_CALCULATOR_LOCATIONS_ENABLED="false"
# 仅限固定 China/Xiamen -> Russia/Moscow 试点；生产环境保持关闭。
OZON_GLOBAL_CALCULATOR_STATIC_PILOT_FALLBACK_ENABLED="false"
# 每套 local/VPS/cloud 部署使用稳定且唯一的 ID；生产环境必填，不随域名变化。
SS_ERP_DEPLOYMENT_ID="local-dev"
AUTH_JWT_ISSUER="ss-erp-local"
# 设备 JWT 使用独立的 32+ 字符密钥；生产环境不得留空。
EXTENSION_DEVICE_JWT_SECRET=""
# 迁移期保留旧的无类型账号 JWT；Unit 9 截止部署设为 false 并清理旧 session:*。
AUTH_ACCEPT_LEGACY_ACCOUNT_TOKENS="true"
# 默认生产环境为 true。仅 HTTP staging 临时测试可设 false；正式 HTTPS 必须保持 true。
AUTH_COOKIE_SECURE=""

# ===== 首个超级管理员初始化令牌（生产必填） =====
# 仅用于 /setup 首次创建 ADMIN。生产环境缺失时，后端会拒绝公网初始化管理员。
# 创建首个管理员后可以删除或轮换；后续用户/员工应由管理员后台创建或邀请。
SETUP_TOKEN=""

# ===== 服务端 =====
NODE_ENV="development"
SERVER_HOST="127.0.0.1"
SERVER_PORT="3001"
LOG_LEVEL="info"
# 运行模式：local（本地离线版）/ cloud（云端 SaaS）
RUNTIME_MODE="local"

# ===== CORS（生产必填，多个域名用逗号分隔） =====
# 开发环境会自动放行 localhost / 127.0.0.1 / chrome-extension://
CORS_ORIGIN="http://localhost:3000"

# ===== 前端 =====
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_RUNTIME_MODE="local"
# 必须与后端物流分发开关协调启用；默认隐藏尚未启用的管理入口。
NEXT_PUBLIC_LOGISTICS_DISTRIBUTION_ENABLED="false"

# ===== 域名分离（云端 SaaS 多域名部署可选） =====
# 配置后，访问 admin 域名只能进 /admin/* 路由，访问 user 域名禁止访问 /admin/*
# 单域名部署留空即可
NEXT_PUBLIC_ADMIN_HOSTNAME=""
NEXT_PUBLIC_USER_HOSTNAME=""

# ===== Cloudflare Turnstile（注册/登录人机验证，生产推荐） =====
# 这些 env 是后台 SystemConfig 的 fallback。云端也可以在超管后台 -> 系统设置 -> 短信与人机验证中填写。
# 不配置时：开发环境直接放行；生产环境拒绝短信发码和登录二次验证
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ===== 短信验证码（生产必填） =====
# 这些 env 是后台 SystemConfig 的 fallback。云端也可以在超管后台 -> 系统设置 -> 短信与人机验证中填写。
# SMS_PROVIDER 取值：tencent | console（aliyun 入口预留但当前未实现）
# 开发环境默认 console（验证码打到日志）；生产环境必须配置真实 provider
SMS_PROVIDER="console"

# 腾讯云短信（SMS_PROVIDER=tencent 时填写）
SMS_TENCENT_SECRET_ID=""
SMS_TENCENT_SECRET_KEY=""
SMS_TENCENT_REGION="ap-guangzhou"
SMS_TENCENT_SDK_APP_ID=""
SMS_TENCENT_SIGN_NAME=""
SMS_TENCENT_TEMPLATE_ID=""

# ===== Sentry 错误追踪（生产推荐） =====
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# 用于关联 release（可选）
APP_VERSION=""

# ===== 后台任务 / 一键上架状态刷新 =====
# 本地默认：每 30 秒刷新最多 10 个任务，并发 3。VPS/生产可提高，但建议先观察 Ozon 429/超时。
LISTING_TASK_REFRESH_INTERVAL_MS="30000"
LISTING_TASK_REFRESH_BATCH_SIZE="10"
LISTING_TASK_REFRESH_CONCURRENCY="3"
LISTING_TASK_REFRESH_LOOKBACK_HOURS="48"
OZON_API_TIMEOUT_MS="20000"
# ===== 出口代理（访问 OZON / 汇率 API 受限时配置） =====
HTTPS_PROXY=""
HTTP_PROXY=""
ALL_PROXY=""

# ===== 图片存储 / 对象存储 =====
# IMAGE_STORAGE_BACKEND: local（本地开发）| ozon-cdn（复用店铺 cookie）| oss（云端推荐）
IMAGE_STORAGE_BACKEND="local"
LOCAL_BASE_URL="http://localhost:3001"
OZON_CDN_RELAY_URL=""
OSS_FALLBACK_TO_CDN="true"

# IMAGE_STORAGE_BACKEND=oss 时必填
OSS_ENDPOINT=""
OSS_BUCKET=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_REGION="auto"
OSS_CDN_DOMAIN=""
# 对象路径固定为 userId/category/yyyy/mm/hash.ext。

# ===== 便携包（Windows 离线版用，无关云端部署） =====
# 指定外部 config.json 的绝对路径，覆盖以上 env
# SS_ERP_CONFIG=""
# 法律文档配置：local | cloud-cn | cloud-global | self-hosted
LEGAL_PROFILE="local"
