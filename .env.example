# SS ERP 环境变量样例
# 复制为 .env 后修改值。生产环境请用 .env.production.example 作为基准。
# 字段按代码实际读取整理，未列出的字段不会被代码使用。

# ===== 数据库（必填） =====
DATABASE_URL="postgresql://user:password@localhost:5432/ss_erp"

# ===== Redis / 队列（推荐） =====
# 默认连接 redis://localhost:6379；生产短信验证码、登录失败计数和 BullMQ worker 依赖 Redis
# 本地开发如需禁用 Redis，设置 REDIS_DISABLED=1（注册短信验证码不可用）
REDIS_URL="redis://localhost:6379"
REDIS_DISABLED="0"

# ===== 加密密钥（生产必填，开发可留空，长度 ≥32） =====
# 用于加密店铺 API Key
ENCRYPTION_KEY=""

# ===== JWT（生产必填，开发可留空，长度 ≥16） =====
JWT_SECRET=""
JWT_EXPIRES_IN="7d"
SESSION_TTL_SECONDS="604800"

# ===== 服务端 =====
NODE_ENV="development"
SERVER_HOST="0.0.0.0"
SERVER_PORT="3001"
LOG_LEVEL="info"

# ===== CORS（生产必填，多个域名用逗号分隔） =====
# 开发环境会自动放行 localhost / 127.0.0.1 / chrome-extension://
CORS_ORIGIN="http://localhost:3000"

# ===== 前端 =====
NEXT_PUBLIC_API_BASE_URL="http://localhost:3001"

# ===== Cloudflare Turnstile（注册/登录人机验证，生产推荐） =====
# 不配置时：开发环境直接放行；生产环境拒绝短信发码和登录二次验证
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ===== 短信验证码（生产必填） =====
# SMS_PROVIDER 取值：tencent | console（aliyun 入口预留但当前未实现）
# 开发环境默认 console（验证码打到日志）；生产环境必须配置真实 provider
SMS_PROVIDER="console"

# 腾讯云短信（SMS_PROVIDER=tencent 时填写）
SMS_TENCENT_SECRET_ID=""
SMS_TENCENT_SECRET_KEY=""
SMS_TENCENT_REGION="ap-guangzhou"
SMS_TENCENT_SDK_APP_ID=""
SMS_TENCENT_SIGN_NAME=""
SMS_TENCENT_TEMPLATE_ID=""

# ===== Sentry 错误追踪（生产推荐） =====
SENTRY_DSN=""
# 用于关联 release（可选）
APP_VERSION=""

# ===== 出口代理（访问 OZON / 汇率 API 受限时配置） =====
HTTPS_PROXY=""
HTTP_PROXY=""
ALL_PROXY=""

# ===== 对象存储（OSS） =====
# 注意：OSS 配置走超管 UI（/admin/settings；后端 API /api/admin/system-config），存于数据库 system_configs 表，
# 不在 .env 中配置。需要的字段：endpoint / bucket / accessKeyId / accessKeySecret /
# region / cdnDomain / pathPrefix。

# ===== 便携包（Windows 离线版用，无关云端部署） =====
# 指定外部 config.json 的绝对路径，覆盖以上 env
# SS_ERP_CONFIG=""
