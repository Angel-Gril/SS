# SS ERP Windows local environment template
# Copy to .env.local-windows, or run .\scripts\windows-local\prepare.ps1 to generate one with local secrets.
# Fields here match environment variables currently read by the codebase or smoke scripts.

# Database
# PostgreSQL service and the ss_erp database must already exist before start.ps1 runs.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ss_erp"

# Redis / queues
# Redis has no official stable Windows distribution. Use WSL/Docker/a trusted compatible service for full Worker validation.
# Set REDIS_DISABLED="1" only for minimal local testing; queue workers are not fully validated in that mode.
REDIS_URL="redis://127.0.0.1:6379"
REDIS_DISABLED="0"

# Local secrets
JWT_SECRET="replace-with-local-jwt-secret-min-16"
JWT_EXPIRES_IN="7d"
SESSION_TTL_SECONDS="604800"
ENCRYPTION_KEY="replace-with-local-encryption-key-min-32"
SETUP_TOKEN="replace-with-local-setup-token"

# Server
NODE_ENV="development"
SERVER_HOST="127.0.0.1"
SERVER_PORT="3001"
LOG_LEVEL="info"
RUN_WORKERS="1"
RUNTIME_MODE="local"
AUTH_COOKIE_SECURE="false"

# CORS
CORS_ORIGIN="http://127.0.0.1:3000,http://localhost:3000"
CORS_EXTENSION_ORIGINS="chrome-extension://*"

# Web / smoke
NEXT_PUBLIC_API_BASE_URL="http://127.0.0.1:3001"
NEXT_PUBLIC_WEB_BASE_URL="http://127.0.0.1:3000"
NEXT_PUBLIC_RUNTIME_MODE="local"
NEXT_PUBLIC_ADMIN_HOSTNAME=""
NEXT_PUBLIC_USER_HOSTNAME=""

# Auth challenges
# The code does not read FEATURE_SMS_REGISTER / FEATURE_TURNSTILE_LOGIN env vars.
# In local mode, login/register challenge bypass is controlled by RUNTIME_MODE=local.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
SMS_PROVIDER="console"

# Local image storage
IMAGE_STORAGE_BACKEND="local"
LOCAL_BASE_URL="http://127.0.0.1:3001"
OZON_CDN_RELAY_URL=""
OSS_FALLBACK_TO_CDN="false"

# OSS/R2 intentionally empty for Windows local default
OSS_ENDPOINT=""
OSS_BUCKET=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_REGION="auto"
OSS_CDN_DOMAIN=""
