# Runtime
NODE_ENV=production
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
LOG_LEVEL=info

# Public URLs
CORS_ORIGIN=https://app.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
PUBLIC_APP_URL=https://app.example.com
PUBLIC_API_URL=https://api.example.com

# Database and queue
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ss_erp?schema=public
REDIS_URL=redis://:PASSWORD@HOST:6379
REDIS_DISABLED=false

# Auth and crypto
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=7d
SESSION_TTL_SECONDS=604800
ENCRYPTION_KEY=replace-with-32-byte-minimum-random-secret

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-site-key
TURNSTILE_SECRET_KEY=replace-with-secret-key

# SMS provider
SMS_PROVIDER=tencent
SMS_TENCENT_SECRET_ID=replace-with-secret-id
SMS_TENCENT_SECRET_KEY=replace-with-secret-key
SMS_TENCENT_REGION=ap-guangzhou
SMS_TENCENT_SDK_APP_ID=replace-with-sdk-app-id
SMS_TENCENT_SIGN_NAME=replace-with-sign-name
SMS_TENCENT_TEMPLATE_ID=replace-with-template-id

# S3-compatible object storage
OSS_ENDPOINT=https://oss-region.example.com
OSS_REGION=auto
OSS_BUCKET=ss-erp-prod
OSS_ACCESS_KEY_ID=replace-with-access-key
OSS_ACCESS_KEY_SECRET=replace-with-secret-key
OSS_CDN_DOMAIN=https://assets.example.com
OSS_PATH_PREFIX=ss-erp

# Network egress proxy, if required by deployment region
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=
