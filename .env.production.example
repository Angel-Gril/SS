# SS ERP 生产环境变量样例
# 在此基础上填写真实密钥/域名后保存为 .env.production
# 字段按代码实际读取整理；敏感集成配置通过环境变量提供。

# ===== Runtime =====
NODE_ENV=production
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
LOG_LEVEL=info
# 运行模式：生产云端必须为 cloud；本地离线版使用 local
RUNTIME_MODE=cloud

# ===== Public URLs =====
CORS_ORIGIN=https://app.example.com
# 官网受控分发时填实际安装包的固定扩展 ID，例如 chrome-extension://abcdefghijklmnopabcdefghijklmnop
CORS_EXTENSION_ORIGINS=
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
NEXT_PUBLIC_RUNTIME_MODE=cloud
# 分域部署分别填写 app/admin/root 主机；单域部署三个值填写同一主机。
# 留空保持国际站 app.ss-erp.com / admin.ss-erp.com / ss-erp.com 默认值。
NEXT_PUBLIC_USER_HOSTNAME=app.example.com
NEXT_PUBLIC_ADMIN_HOSTNAME=admin.example.com
# EXTENSION_CLOUD_BASE_URL 仅用于扩展打开 Web；设备领取 API 精确使用 NEXT_PUBLIC_API_BASE_URL。
NEXT_PUBLIC_MARKETING_HOSTNAME=example.com
EXTENSION_CLOUD_BASE_URL=https://app.example.com
# 正式扩展发布审批值必须与本次 Web/Admin/API 部署精确一致，不从上面三项自动推导。
EXTENSION_RELEASE_EXPECTED_WEB_ORIGIN=https://app.example.com
EXTENSION_RELEASE_EXPECTED_ADMIN_ORIGIN=https://admin.example.com
EXTENSION_RELEASE_EXPECTED_API_ORIGIN=https://api.example.com
EXTENSION_RELEASE_EXPECTED_LOCAL_ORIGIN=http://127.0.0.1:3001
# 默认隐藏尚未启用的物流规则管理入口。
NEXT_PUBLIC_LOGISTICS_DISTRIBUTION_ENABLED=false
NEXT_PUBLIC_EXTENSION_DEVICE_AUTH_ENABLED=false

# ===== Database / Redis =====
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/ss_erp?schema=public
# Human-readable label plus a root-owned release-evidence directory. The gate also queries the
# actual database name/OID and its stored deployment UUID; the backup URL may use another route.
DEPLOY_DATABASE_ID=production-primary
DEPLOY_BACKUP_LOCAL_DIR=/var/backups/ss-erp
DEPLOY_BACKUP_MAX_AGE_MINUTES=120
DEPLOY_BACKUP_VERIFY_TIMEOUT=20m
REDIS_URL=redis://:PASSWORD@HOST:6379
REDIS_DISABLED=0

# ===== Auth / Crypto（生产必填，长度校验在 bootstrap-config.ts） =====
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRES_IN=7d
SESSION_TTL_SECONDS=604800
# 扩展认证迁移模式：compat 保留旧 Token；device-only 仅允许设备配对。
EXTENSION_AUTH_MODE=compat
# 中央物流规则分发默认关闭；启用前必须替换下列 deployment/issuer/device secret 占位值。
LOGISTICS_DISTRIBUTION_ENABLED=false
EXTENSION_DEVICE_AUTH_ENABLED=false
SS_ERP_DEPLOYMENT_ID=replace-with-stable-deployment-id
AUTH_JWT_ISSUER=replace-with-stable-auth-issuer
# 必须使用不同于 JWT_SECRET 的独立 32+ 字符随机密钥。
EXTENSION_DEVICE_JWT_SECRET=replace-with-separate-32-byte-minimum-random-secret
EXTENSION_COMMAND_GRANT_SECRET=replace-with-another-separate-32-byte-minimum-random-secret
# 迁移期为 true；Unit 9 截止部署设为 false，并清理旧 Redis session。
AUTH_ACCEPT_LEGACY_ACCOUNT_TOKENS=true
ENCRYPTION_KEY=replace-with-32-byte-minimum-random-secret
# 正式 HTTPS 必须为 true 或留空。仅 HTTP staging 临时测试可设 false。
AUTH_COOKIE_SECURE=true
# 新会话始终使用 host-only Cookie，避免 app/admin 会话互相覆盖。仅旧部署迁移清理时填写原父域。
AUTH_COOKIE_DOMAIN=

# ===== First admin setup（生产必填） =====
# 首次访问 /setup 创建超级管理员时填写。创建完成后可删除或轮换。
SETUP_TOKEN=replace-with-one-time-random-setup-token

# ===== Cloudflare Turnstile =====
# 显式 env 会覆盖超管后台配置；二选一，避免两处值不一致。
# 国际站使用 cloudflare-turnstile；国内站建议改为 builtin-pow。
HUMAN_CHALLENGE_PROVIDER=cloudflare-turnstile
# TURNSTILE_SECRET_KEY 给后端校验；NEXT_PUBLIC_TURNSTILE_SITE_KEY 给前端组件渲染
TURNSTILE_SECRET_KEY=replace-with-secret-key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-site-key
# 精确 hostname，英文逗号分隔；Turnstile 模式下为空会拒绝所有验证。
TURNSTILE_ALLOWED_HOSTNAMES=ss-erp.com,www.ss-erp.com,app.ss-erp.com,admin.ss-erp.com
# builtin-pow 模式至少配置 32 位随机密钥；Turnstile 模式可留空。
HUMAN_CHALLENGE_SIGNING_SECRET=
HUMAN_CHALLENGE_POW_DIFFICULTY=4
HUMAN_CHALLENGE_TTL_SECONDS=120

# ===== SMS provider =====
# 可直接写 env，也可部署后在超管后台 -> 系统设置 -> 短信与人机验证中填写（后台配置优先）。
# 取值：aliyun | tencent | console（仅测试）
SMS_PROVIDER=aliyun
# 推荐在阿里云 ECS 上使用 ecs_ram_role，避免把长期 AccessKey 放进应用环境。
SMS_ALIYUN_CREDENTIAL_MODE=auto
ALIBABA_CLOUD_IMDSV1_DISABLED=true
SMS_ALIYUN_ROLE_NAME=
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=
# 模板验证码变量名，默认 code，对应模板参数 {"code":"123456"}
SMS_ALIYUN_TEMPLATE_PARAM_NAME=code
SMS_ALIYUN_REGISTER_TEMPLATE_CODE=
SMS_ALIYUN_REGISTER_TEMPLATE_PARAM_NAME=code
SMS_ALIYUN_PASSWORD_RESET_TEMPLATE_CODE=
SMS_ALIYUN_PASSWORD_RESET_TEMPLATE_PARAM_NAME=code
SMS_ALIYUN_SMS_LOGIN_TEMPLATE_CODE=
SMS_ALIYUN_SMS_LOGIN_TEMPLATE_PARAM_NAME=code

# 腾讯云短信（SMS_PROVIDER=tencent 时填写）
SMS_TENCENT_SECRET_ID=replace-with-secret-id
SMS_TENCENT_SECRET_KEY=replace-with-secret-key
SMS_TENCENT_REGION=ap-guangzhou
SMS_TENCENT_SDK_APP_ID=replace-with-sdk-app-id
SMS_TENCENT_SIGN_NAME=replace-with-sign-name
SMS_TENCENT_TEMPLATE_ID=replace-with-template-id

# ===== Sentry 错误追踪 =====
SENTRY_DSN=https://your-key@o123456.ingest.sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-key@o123456.ingest.sentry.io/project-id
# 用于关联 release（可选）
APP_VERSION=

# ===== 后台任务 / 一键上架状态刷新 =====
# VPS 推荐初始值：每 30 秒刷新最多 30 个任务，并发 6。稳定无 429/超时后可把并发调到 8-10。
LISTING_TASK_REFRESH_INTERVAL_MS=30000
LISTING_TASK_REFRESH_BATCH_SIZE=30
LISTING_TASK_REFRESH_CONCURRENCY=6
LISTING_TASK_REFRESH_LOOKBACK_HOURS=72
OZON_API_TIMEOUT_MS=20000
# ===== 出口代理（访问 OZON / 汇率 API 受限时配置） =====
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=

# ===== 图片存储 / 对象存储 =====
# 生产云端推荐 oss；OSS 暂未准备好时可临时改为 ozon-cdn。
IMAGE_STORAGE_BACKEND=oss
LOCAL_BASE_URL=https://app.example.com
OZON_CDN_RELAY_URL=
OSS_FALLBACK_TO_CDN=true

# IMAGE_STORAGE_BACKEND=oss 时必填
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=replace-with-bucket
OSS_ACCESS_KEY_ID=replace-with-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-access-key-secret
OSS_REGION=cn-hangzhou
OSS_CDN_DOMAIN=
# 对象路径固定为 userId/category/yyyy/mm/hash.ext。

# ===== 数据库备份（脚本读取，独立于应用 .env） =====
# 见 scripts/backup-db.sh + /etc/ss-erp-backup.env
# 法律文档必须按部署选择：ss-erp.cn=cloud-cn，ss-erp.com=cloud-global，客户独立服务器=self-hosted
# 修改版本正文时，同时更新 packages/shared/src/legal.ts 中对应的文档版本号。
LEGAL_PROFILE=cloud-global
