# SS ERP Staging 环境变量
# 用于 staging.yourdomain.com 独立测试环境
# 与生产完全隔离：独立数据库、独立 Redis、独立 OSS bucket、独立短信模板

NODE_ENV=production
SERVER_HOST=0.0.0.0
SERVER_PORT=3001
LOG_LEVEL=debug

# URLs
CORS_ORIGIN=https://staging.yourdomain.com
NEXT_PUBLIC_API_BASE_URL=https://staging.yourdomain.com/api

# Database（独立库，不要共用生产库！）
DATABASE_URL=postgresql://ss_erp_staging:PASSWORD@localhost:5432/ss_erp_staging

# Redis（可共用同一实例但用不同 db 号）
REDIS_URL=redis://:PASSWORD@localhost:6379/1
REDIS_DISABLED=0

# Auth / Crypto（staging 专用密钥，不要和生产相同）
JWT_SECRET=staging-jwt-secret-at-least-32-chars-long
JWT_EXPIRES_IN=7d
SESSION_TTL_SECONDS=604800
ENCRYPTION_KEY=staging-encryption-key-at-least-32-chars

# Turnstile（使用 Cloudflare 测试密钥，永远通过）
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# SMS（staging 用 console 模式，验证码打到日志）
SMS_PROVIDER=console

# Sentry（可选：staging 用独立 project 或不配）
SENTRY_DSN=

# 代理
HTTPS_PROXY=
