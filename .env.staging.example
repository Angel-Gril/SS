# SS ERP Staging 环境变量
# 用于 staging.yourdomain.com 独立测试环境
# 与生产完全隔离：独立数据库、独立 Redis、独立 OSS bucket、独立短信模板

NODE_ENV=production
SERVER_HOST=127.0.0.1
SERVER_PORT=3001
LOG_LEVEL=debug

# 运行模式：local（本地离线版）/ cloud（云端 SaaS）
RUNTIME_MODE=cloud

# URLs
CORS_ORIGIN=https://staging.yourdomain.com
# 浏览器扩展来源。staging 可临时用 chrome-extension://*；正式环境改为固定扩展 ID。
CORS_EXTENSION_ORIGINS=chrome-extension://*
NEXT_PUBLIC_API_BASE_URL=https://staging.yourdomain.com/api
NEXT_PUBLIC_RUNTIME_MODE=cloud
NEXT_PUBLIC_USER_HOSTNAME=staging.yourdomain.com
NEXT_PUBLIC_ADMIN_HOSTNAME=staging.yourdomain.com
NEXT_PUBLIC_MARKETING_HOSTNAME=staging.yourdomain.com
# 扩展打开 ERP 时使用的 Web 地址；设备领取 API 仍精确使用 NEXT_PUBLIC_API_BASE_URL。
EXTENSION_CLOUD_BASE_URL=https://staging.yourdomain.com
EXTENSION_RELEASE_EXPECTED_WEB_ORIGIN=https://staging.yourdomain.com
EXTENSION_RELEASE_EXPECTED_ADMIN_ORIGIN=https://staging.yourdomain.com
EXTENSION_RELEASE_EXPECTED_API_ORIGIN=https://staging.yourdomain.com
NEXT_PUBLIC_EXTENSION_DEVICE_AUTH_ENABLED=false

# Database（compose 内置独立库，不要共用生产库！）
# connection_limit: Prisma 连接池大小（默认 5；staging 共用 env 先用 20）
# pool_timeout: 等待连接超时秒数
DATABASE_URL="postgresql://ss_erp_staging:change-me-staging-db@postgres:5432/ss_erp_staging?connection_limit=20&pool_timeout=10"

# Redis（compose 内置 redis 服务；如使用外部 Redis，可改为独立实例 / db 号）
REDIS_URL=redis://redis:6379/1
REDIS_DISABLED=0

# Worker 隔离（API 实例设 0，独立 worker 容器默认跑全部 worker）
# RUN_WORKERS=0

# Auth / Crypto（staging 专用密钥，不要和生产相同）
JWT_SECRET=staging-jwt-secret-at-least-32-chars-long
JWT_EXPIRES_IN=7d
SESSION_TTL_SECONDS=604800
# 扩展设备认证可独立于物流分发启用。打开前替换下列稳定 ID 和独立随机密钥。
EXTENSION_DEVICE_AUTH_ENABLED=false
SS_ERP_DEPLOYMENT_ID=replace-with-stable-staging-deployment-id
AUTH_JWT_ISSUER=replace-with-stable-staging-auth-issuer
EXTENSION_DEVICE_JWT_SECRET=replace-with-separate-32-byte-minimum-random-secret
EXTENSION_COMMAND_GRANT_SECRET=replace-with-another-separate-32-byte-minimum-random-secret
ENCRYPTION_KEY=staging-encryption-key-at-least-32-chars
SETUP_TOKEN=staging-first-admin-setup-token-change-me
# 如果 staging 只有 HTTP 公网 IP，设 false 才能保存登录 cookie；绑定 HTTPS 域名后改回 true 或删除。
AUTH_COOKIE_SECURE=false

# Turnstile（使用 Cloudflare 测试密钥，永远通过）
HUMAN_CHALLENGE_PROVIDER=cloudflare-turnstile
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# 改成实际 staging 登录域名；只在本机测试时可使用 localhost。
TURNSTILE_ALLOWED_HOSTNAMES=localhost
HUMAN_CHALLENGE_SIGNING_SECRET=
HUMAN_CHALLENGE_POW_DIFFICULTY=4
HUMAN_CHALLENGE_TTL_SECONDS=120

# SMS（cloud staging 默认关闭；真实短信验收时使用独立测试签名、模板和机器凭证）
SMS_PROVIDER=
# 真实阿里云验收时填写独立测试应用的以下字段，不要复用生产 AccessKey。
SMS_ALIYUN_CREDENTIAL_MODE=auto
ALIBABA_CLOUD_IMDSV1_DISABLED=true
SMS_ALIYUN_ROLE_NAME=
SMS_ALIYUN_ACCESS_KEY_ID=
SMS_ALIYUN_ACCESS_KEY_SECRET=
SMS_ALIYUN_SIGN_NAME=
SMS_ALIYUN_TEMPLATE_CODE=
SMS_ALIYUN_TEMPLATE_PARAM_NAME=code
SMS_ALIYUN_REGISTER_TEMPLATE_CODE=
SMS_ALIYUN_REGISTER_TEMPLATE_PARAM_NAME=code
SMS_ALIYUN_PASSWORD_RESET_TEMPLATE_CODE=
SMS_ALIYUN_PASSWORD_RESET_TEMPLATE_PARAM_NAME=code
SMS_ALIYUN_SMS_LOGIN_TEMPLATE_CODE=
SMS_ALIYUN_SMS_LOGIN_TEMPLATE_PARAM_NAME=code

# 图片存储 / 对象存储
# OSS 未准备好前可用 ozon-cdn 跑上架链路；接入独立 bucket 后切换为 oss。
IMAGE_STORAGE_BACKEND=ozon-cdn
LOCAL_BASE_URL=https://staging.yourdomain.com
OZON_CDN_RELAY_URL=
OSS_FALLBACK_TO_CDN=true
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_REGION=auto
OSS_CDN_DOMAIN=

# Sentry（可选：staging 用独立 project 或不配）
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# 代理
HTTPS_PROXY=
# 按测试目标改为 cloud-cn、cloud-global 或 self-hosted。
LEGAL_PROFILE=cloud-global
