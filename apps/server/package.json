{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run",
    "test:logistics:postgres": "vitest run --no-file-parallelism src/__tests__/logistics-rule-release.postgres.integration.test.ts src/__tests__/extension-device-session.postgres.integration.test.ts src/__tests__/logistics-rule-device-prisma.postgres.integration.test.ts src/__tests__/logistics-capture-task.postgres.integration.test.ts src/__tests__/logistics-scope-bootstrap.postgres.integration.test.ts src/__tests__/logistics-official-input-unit-contract.postgres.integration.test.ts src/__tests__/extension-command-grants.postgres.integration.test.ts src/__tests__/source-capture.postgres.integration.test.ts src/__tests__/source-listing-workflow.postgres.integration.test.ts src/__tests__/ozon-publisher-rollout-gate.postgres.integration.test.ts",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "smoke:live": "node scripts/live-smoke.mjs",
    "smoke:remote": "node scripts/remote-smoke.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1055.0",
    "@fastify/cookie": "^11.0.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@prisma/client": "^6.2.1",
    "@sentry/node": "^10.54.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.34.8",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "ipaddr.js": "^2.4.0",
    "jsonwebtoken": "^9.0.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.2.1",
    "shared": "workspace:*",
    "sharp": "^0.34.5",
    "tencentcloud-sdk-nodejs-sms": "^4.1.228",
    "undici": "^8.7.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/sharp": "^0.32.0",
    "@vitest/ui": "^4.1.7",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.7"
  }
}
