// 客户端版本管理（强制/推荐更新）
model AppVersion {
  id           String   @id @default(cuid())
  platform     String   // web | electron | extension
  version      String   // semver, e.g. "1.2.0"
  minVersion   String   @map("min_version") // 低于此版本强制更新
  releaseNotes String?  @map("release_notes")
  downloadUrl  String?  @map("download_url")
  isActive     Boolean  @default(true) @map("is_active")
  publishedAt  DateTime @default(now()) @map("published_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([platform, version])
  @@index([platform, isActive])
  @@map("app_versions")
}

// ─── 公告系统 ───

enum AnnouncementType {
  NOTICE
  UPDATE
  ALERT
}

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  CRITICAL
}

enum AnnouncementTargetRole {
  ALL
  USER
  ADMIN
  STAFF
}

model Announcement {
  id          String                 @id @default(cuid())
  title       String
  content     String                 // 富文本 HTML
  type        AnnouncementType       @default(NOTICE)
  priority    AnnouncementPriority   @default(NORMAL)
  targetRole  AnnouncementTargetRole @default(ALL) @map("target_role")
  attachments Json?                  // [{name, url, size}]
  forcePopup  Boolean                @default(false) @map("force_popup")
  publishedAt DateTime?              @map("published_at")
  expiresAt   DateTime?              @map("expires_at")
  createdBy   String                 @map("created_by")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  creator     User                   @relation("AnnouncementCreator", fields: [createdBy], references: [id])
  reads       AnnouncementRead[]

  @@index([publishedAt])
  @@index([targetRole, publishedAt])
  @@map("announcements")
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String       @map("announcement_id")
  userId         String       @map("user_id")
  readAt         DateTime     @default(now()) @map("read_at")

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId, readAt])
  @@map("announcement_reads")
}
