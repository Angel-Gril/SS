  orderId             String    @unique @map("order_id")
  shopId              String    @map("shop_id")
  userId              String    @map("user_id")
  accountCode         String?   @map("account_code")
  yearMonth           String    @map("year_month")
  orderDate           DateTime  @map("order_date")
  orderStatus         String    @map("order_status")
  exchangeRateUsed    Decimal?  @db.Decimal(12, 6) @map("exchange_rate_used")
  saleAmountCny       Decimal?  @db.Decimal(12, 2) @map("sale_amount_cny")
  commissionCny       Decimal?  @db.Decimal(12, 2) @map("commission_cny")
  purchaseCostCny     Decimal?  @db.Decimal(12, 2) @map("purchase_cost_cny")
  packageFeeCny       Decimal?  @db.Decimal(12, 2) @map("package_fee_cny")
  shippingDomesticCny Decimal?  @db.Decimal(12, 2) @map("shipping_domestic_cny")
  shippingLastMileCny Decimal?  @db.Decimal(12, 2) @map("shipping_last_mile_cny")
  shippingIntlCny     Decimal?  @db.Decimal(12, 2) @map("shipping_intl_cny")
  shippingPostCny     Decimal?  @db.Decimal(12, 2) @map("shipping_post_cny")
  adCny               Decimal?  @db.Decimal(12, 2) @map("ad_cny")
  penaltyCny          Decimal?  @db.Decimal(12, 2) @map("penalty_cny")
  otherFeeCny         Decimal?  @db.Decimal(12, 2) @map("other_fee_cny")
  profitCny           Decimal?  @db.Decimal(12, 2) @map("profit_cny")
  marginPct           Decimal?  @db.Decimal(6, 2)  @map("margin_pct")
  status              String    @default("provisional")
