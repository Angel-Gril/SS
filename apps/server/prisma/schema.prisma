generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  USER
  STAFF
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum Platform {
  OZON
  YANDEX
  KASPI
  WILDBERRIES
}

enum ShopStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum SyncJobType {
  PRODUCT_PULL
  PRODUCT_PUSH
  ORDER_PULL
  STOCK_PUSH
  IMAGE_RESIZE
  RETURN_PULL
}

enum SyncJobStatus {
  PENDING
  RUNNING
  SUCCESS
  FAILED
}

enum BalanceLogType {
  RECHARGE
  CONSUME
  REFUND
  ADJUST
}

enum LogisticsChannelType {
  TENANT
  PUBLIC
}

enum LogisticsSourceOwnerType {
  TENANT
  PUBLIC
}

enum LogisticsConfidentiality {
  TENANT_PRIVATE
  PUBLIC
}

enum LogisticsValidationStatus {
  DRAFT
  PASSED
  FAILED
}

enum LogisticsBindingStatus {
  CANDIDATE
  VERIFIED
  INVALIDATED
}

enum LogisticsReviewStatus {
  SUGGESTED
  CONFIRMED
  REJECTED
  INVALIDATED
}

enum LogisticsReleaseKind {
  PUBLISH
  ROLLBACK
}

enum LogisticsRuleEventType {
  REVISION_CREATED
  BINDING_CHANGED
  PUBLISHED
  ROLLED_BACK
  INVALIDATED
}

enum ExtensionDevicePairingStatus {
  PENDING
  CLAIMED
  CANCELED
}

enum ExtensionDeviceSessionStatus {
  ACTIVE
  REVOKED
}

enum ExtensionDeviceRefreshFamilyStatus {
  ACTIVE
  REVOKED
}

enum ExtensionDeviceShopGrantStatus {
  ACTIVE
  REVOKED
}

enum ExtensionDeviceAssignmentGrantStatus {
  ACTIVE
  REVOKED
}

enum ExtensionCommandOperation {
  SOURCE_CAPTURE
  LISTING_WRITE
  LISTING_REVIEW
  MEDIA_EXECUTE
  MEDIA_REVIEW
  MEDIA_APPLY
  BYOK_MEDIA_INGEST
  OZON_PUBLISH
}

enum ExtensionCommandReceiptStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum SourceCaptureIngestChannel {
  EXTENSION_DEVICE
  WEB_ACCOUNT
  LEGACY_ADAPTER
}

enum SourceOzonCategoryMappingScope {
  TENANT
  GLOBAL
}

enum SourceOzonCategoryMappingStatus {
  ACTIVE
  REJECTED
  RETIRED
}

enum SourceOzonCategoryMappingDecisionAction {
  CONFIRM
  REJECT
  PROMOTE
}

enum SourceListingWorkflowStatus {
  ACTIVE
  PAUSED
  CANCELLED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
  MANUAL_REVIEW
  COMPLETED
}

enum SourceListingDraftStatus {
  ACTIVE
  PAUSED
  CANCELLED
  RETRYABLE_FAILURE
  PERMANENT_FAILURE
  MANUAL_REVIEW
  READY
  PUBLISHED
}

enum OzonPublishAttemptState {
  PREPARED
  SUBMITTING
  SUBMITTED
  UNKNOWN
  REJECTED
}

enum OzonPublishReconciliationState {
  NOT_REQUIRED
  PENDING
  RUNNING
  RETRY_WAIT
  SUCCEEDED
  PARTIAL_FAILURE
  FAILED
  MANUAL_REVIEW
}

enum OzonPublishLeasePurpose {
  SUBMIT
  RECONCILE
}

enum OzonPublisherParityEntrypoint {
  COLLECT_PUBLISH_OZON
  LISTING_BATCH
  LISTING_IMPORT_BY_SKU
  BROWSER_ONE_CLICK
  EXTENSION_ADAPTER
}

enum OzonPublisherParityReportStatus {
  MATCH
  DIFFERENT
  V2_BLOCKED
  NOT_COMPARABLE
}

enum OzonPublisherParityClassification {
  MATCH
  INTENTIONAL_STRICTER
  COMPATIBILITY_TRANSFORM
  DEFECT
  NOT_COMPARABLE
}

enum OzonPublisherParityV2Kind {
  COMPILED
  BLOCKED
  UNAVAILABLE
}

enum OzonPublisherParityApprovalState {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

enum OzonPublisherParityDecisionAction {
  APPROVE
  REJECT
  REVOKE
}

enum OzonPublisherWriterEntrypoint {
  COLLECT_PUBLISH_OZON
  LISTING_BATCH
  LISTING_IMPORT_BY_SKU
}

enum OzonPublisherOriginChannel {
  DIRECT
  BROWSER_ONE_CLICK
  EXTENSION_ADAPTER
}

enum OzonPublisherRolloutGateState {
  NOT_READY
  READY
  REVOKED
}

enum OzonPublisherRolloutRecorderResult {
  RECORDED
  FAILED
}

enum OzonPublisherRolloutEvaluationResult {
  NOT_READY
  READY
}

enum OzonPublisherRolloutTransitionAction {
  APPROVE
  REVOKE
}

enum OzonPublisherRolloutBoundary {
  COLLECT_PUBLISH_OZON
  LISTING_BATCH
  LISTING_IMPORT_BY_SKU
  BROWSER_ONE_CLICK
  EXTENSION_ADAPTER
}

enum OzonPublisherRolloutStage {
  off
  shadow
  v2
}

enum ExtensionDeviceSecurityEventType {
  PAIRING_CLAIMED
  SESSION_REVOKED
  REFRESH_REUSE_DETECTED
}

enum ExtensionDeviceRevocationReason {
  PAIRING_APPROVED
  OWNER_REVOKED
  PASSWORD_RESET
  ACCOUNT_SUSPENDED
  ACTOR_UNLINKED
  SHOP_TRANSFERRED
  AUTHORIZATION_INVALID
  SESSION_EXPIRED
  REFRESH_REUSE_DETECTED
  ASSIGNMENT_REVOKED
  ASSIGNMENT_RETIRED
  SHOP_UNLINKED
  WAREHOUSE_RETIRED
  SCOPE_REVOKED
  WORKFLOW_VERSION_CHANGED
}

enum LogisticsRuleReleaseAckStatus {
  APPLIED
  FAILED
}

enum LogisticsCaptureTaskKind {
  SELLER
  OFFICIAL
}

enum LogisticsCaptureTaskStatus {
  ISSUED
  CLAIMED
  REVIEWABLE
  CANCELLED
}

enum LogisticsCaptureCandidateState {
  CAPTURED
  QUARANTINED
}

enum LogisticsCaptureReviewStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum LogisticsScopeBootstrapStatus {
  CANDIDATE
  ACTIVATED
}

enum LogisticsCompanyProbeStatus {
  ISSUED
  CLAIMED
  SUBMITTED
  CONFIRMED
  REJECTED
  EXPIRED
}

model User {
  id                 String     @id @default(cuid())
  phone              String     @unique
  email              String?    @unique
  passwordHash       String     @map("password_hash")
  authVersion        Int        @default(0) @map("auth_version")
  nickname           String?
  avatar             String?
  accountCode        String?    @unique @map("account_code")
  role               UserRole   @default(USER)
  status             UserStatus @default(ACTIVE)
  balance            Decimal    @default(0) @db.Decimal(12, 2)
  parentId           String?    @map("parent_id")
  parent             User?      @relation("UserStaff", fields: [parentId], references: [id], onDelete: SetNull)
  staff              User[]     @relation("UserStaff")
  canInvite          Boolean    @default(false) @map("can_invite")
  inviteLimit        Int        @default(0) @map("invite_limit")
  inviteCount        Int        @default(0) @map("invite_count")
  tenantType         String     @default("transit") @map("tenant_type")
  perOrderFee        Decimal?   @map("per_order_fee") @db.Decimal(10, 2)
  customColorEnabled Boolean    @default(false) @map("custom_color_enabled")
  activePortal       String     @default("user") @map("active_portal")
  isTransitProvider  Boolean    @default(false) @map("is_transit_provider")
  canPublishAddress  Boolean    @default(false) @map("can_publish_address")
  isSuperAdmin       Boolean    @default(false) @map("is_super_admin")
  providerFee        Decimal?   @map("provider_fee") @db.Decimal(10, 2)
  platformFee        Decimal?   @map("platform_fee") @db.Decimal(10, 2)
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")
  lastLoginAt        DateTime?  @map("last_login_at")

  shops                                    Shop[]
  balanceLogs                              BalanceLog[]
  sessions                                 Session[]
  supplyGoods                              SupplyGoods[]
  sourceCandidates                         SourceCandidate[]
  sourceQuotes                             SourceQuote[]
  account                                  UserAccount?
  rechargeOrders                           RechargeOrder[]                           @relation("RechargeOrderUser")
  reviewedRechargeOrders                   RechargeOrder[]                           @relation("RechargeOrderReviewer")
  userServiceTags                          UserServiceTag[]
  createdAnnouncements                     Announcement[]                            @relation("AnnouncementCreator")
  announcementReads                        AnnouncementRead[]
  createdDashboardContentBlocks            DashboardContentBlock[]                   @relation("DashboardContentBlockCreator")
  auditLogs                                AuditLog[]
  ozonAnalyticsCaches                      OzonAnalyticsCache[]
  productSelectionRules                    ProductSelectionRule[]
  productSelectionPoolItems                ProductSelectionPoolItem[]
  legalAcceptances                         LegalAcceptance[]
  ownedAiImageJobs                         AiImageJob[]                              @relation("AiImageJobOwner")
  createdAiImageJobs                       AiImageJob[]                              @relation("AiImageJobActor")
  aiProviderReconciliationEventsAsActor    AiProviderReconciliationEvent[]           @relation("AiProviderReconciliationEventActor")
  ownedAiMediaWorkflows                    AiMediaWorkflow[]                         @relation("AiMediaWorkflowOwner")
  createdAiMediaWorkflows                  AiMediaWorkflow[]                         @relation("AiMediaWorkflowActor")
  reviewedAiMediaWorkflows                 AiMediaWorkflow[]                         @relation("AiMediaWorkflowReviewer")
  aiMediaWorkflowEvents                    AiMediaWorkflowEvent[]
  ownedAiMediaPlans                        AiMediaPlan[]                             @relation("AiMediaPlanOwner")
  createdAiMediaPlans                      AiMediaPlan[]                             @relation("AiMediaPlanActor")
  reviewedAiMediaPlans                     AiMediaPlan[]                             @relation("AiMediaPlanReviewer")
  aiMediaPlanningRunsAsActor               AiMediaPlanningRun[]                      @relation("AiMediaPlanningRunActor")
  aiMediaPlanVersionsAsActor               AiMediaPlanVersion[]                      @relation("AiMediaPlanVersionActor")
  aiMediaPlanEventsAsActor                 AiMediaPlanEvent[]                        @relation("AiMediaPlanEventActor")
  ownedAiMediaSuites                       AiMediaSuite[]                            @relation("AiMediaSuiteOwner")
  createdAiMediaSuites                     AiMediaSuite[]                            @relation("AiMediaSuiteActor")
  aiMediaSuiteEventsAsActor                AiMediaSuiteEvent[]                       @relation("AiMediaSuiteEventActor")
  ownedAiMediaApplicationMutations         AiMediaApplicationMutation[]              @relation("AiMediaApplicationMutationOwner")
  createdAiMediaApplicationMutations       AiMediaApplicationMutation[]              @relation("AiMediaApplicationMutationActor")
  ownedAiMediaListingDraftMutations        AiMediaListingDraftApplicationMutation[]  @relation("AiMediaListingDraftMutationOwner")
  createdAiMediaListingDraftMutations      AiMediaListingDraftApplicationMutation[]  @relation("AiMediaListingDraftMutationActor")
  ownedExtensionHostedListingAssignments   ExtensionHostedAiImageListingAssignment[] @relation("ExtensionHostedListingAssignmentOwner")
  createdExtensionHostedListingAssignments ExtensionHostedAiImageListingAssignment[] @relation("ExtensionHostedListingAssignmentActor")
  extensionAiImageExecutionModeLocks       ExtensionAiImageExecutionModeLock[]       @relation("ExtensionAiImageExecutionModeLockOwner")
  ownedExtensionByokExecutionIntents       ExtensionByokExecutionIntent[]            @relation("ExtensionByokExecutionIntentOwner")
  createdExtensionByokExecutionIntents     ExtensionByokExecutionIntent[]            @relation("ExtensionByokExecutionIntentActor")
  ownedExtensionByokExecutionBatches       ExtensionByokExecutionBatch[]             @relation("ExtensionByokExecutionBatchOwner")
  createdExtensionByokExecutionBatches     ExtensionByokExecutionBatch[]             @relation("ExtensionByokExecutionBatchActor")
  ownedAiMediaSuitePromptSets              AiMediaSuitePromptSet[]                   @relation("AiMediaSuitePromptSetOwner")
  createdAiMediaSuitePromptSets            AiMediaSuitePromptSet[]                   @relation("AiMediaSuitePromptSetActor")
  mediaAssets                              MediaAsset[]
  ownedAiCostReservations                  AiCostReservation[]                       @relation("AiCostReservationOwner")
  createdAiCostReservations                AiCostReservation[]                       @relation("AiCostReservationActor")
  aiCostSettlementsAsActor                 AiCostSettlement[]                        @relation("AiCostSettlementActor")
  logisticsRuleChannels                    LogisticsRuleChannel[]                    @relation("LogisticsChannelTenant")
  logisticsRuleRevisions                   LogisticsRuleRevision[]                   @relation("LogisticsRevisionTenant")
  logisticsRuleAssignments                 LogisticsRuleAssignment[]                 @relation("LogisticsAssignmentTenant")
  shopOzonCompanyBindings                  ShopOzonCompanyBinding[]                  @relation("ShopCompanyBindingTenant")
  warehouseOzonOriginBindings              WarehouseOzonOriginBinding[]              @relation("WarehouseOriginBindingTenant")
  deliveryMethodRuleBindings               ShopDeliveryMethodRuleBinding[]           @relation("MethodRuleBindingTenant")
  officialFormulaResolutions               OfficialSellerFormulaResolution[]         @relation("OfficialResolutionTenant")
  createdExtensionPairingCodes             ExtensionDevicePairingCode[]              @relation("ExtensionPairingActor")
  ownedExtensionPairingCodes               ExtensionDevicePairingCode[]              @relation("ExtensionPairingOwner")
  extensionSessionsAsActor                 ExtensionDeviceSession[]                  @relation("ExtensionSessionActor")
  extensionSessionsAsOwner                 ExtensionDeviceSession[]                  @relation("ExtensionSessionOwner")
  extensionSecurityEventsAsActor           ExtensionDeviceSecurityEvent[]            @relation("ExtensionSecurityEventActor")
  ownedExtensionCommandGrants              ExtensionCommandGrant[]                   @relation("ExtensionCommandGrantOwner")
  ownedExtensionByokMediaProvenance        ExtensionByokMediaProvenance[]            @relation("ExtensionByokMediaProvenanceOwner")
  extensionByokMediaProvenanceAsActor      ExtensionByokMediaProvenance[]            @relation("ExtensionByokMediaProvenanceActor")
  ownedSourceCaptureSubjects               SourceCaptureSubject[]                    @relation("SourceCaptureSubjectOwner")
  sourceCaptureSnapshotsAsActor            SourceCaptureSnapshot[]                   @relation("SourceCaptureSnapshotActor")
  ownedSourceOzonCategoryMappings          SourceOzonCategoryMapping[]               @relation("SourceOzonCategoryMappingOwner")
  createdSourceOzonCategoryMappings        SourceOzonCategoryMapping[]               @relation("SourceOzonCategoryMappingCreator")
  updatedSourceOzonCategoryMappings        SourceOzonCategoryMapping[]               @relation("SourceOzonCategoryMappingUpdater")
  reviewedSourceOzonCategoryMappings       SourceOzonCategoryMapping[]               @relation("SourceOzonCategoryMappingReviewer")
  sourceOzonCategoryMappingDecisions       SourceOzonCategoryMappingDecision[]       @relation("SourceOzonCategoryMappingDecisionActor")
  ownedSourceListingWorkflows              SourceListingWorkflow[]                   @relation("SourceListingWorkflowOwner")
  sourceListingDraftVersionsAsActor        SourceListingDraftVersion[]               @relation("SourceListingDraftVersionActor")
  sourceListingWorkflowEventsAsActor       SourceListingWorkflowEvent[]              @relation("SourceListingWorkflowEventActor")
  ownedSourceListingPublishIntents         SourceListingPublishIntent[]              @relation("SourceListingPublishIntentOwner")
  sourceListingPublishIntentsAsActor       SourceListingPublishIntent[]              @relation("SourceListingPublishIntentActor")
  ownedOzonPublishAttempts                 OzonPublishAttempt[]                      @relation("OzonPublishAttemptOwner")
  ozonPublishAttemptsAsActor               OzonPublishAttempt[]                      @relation("OzonPublishAttemptActor")
  resolvedOzonPublishAttempts              OzonPublishAttempt[]                      @relation("OzonPublishAttemptResolver")
  ozonPublishAttemptEventsAsActor          OzonPublishAttemptEvent[]                 @relation("OzonPublishAttemptEventActor")
  reviewedOzonPublisherParitySubjects      OzonPublisherParityDifferenceSubject[]    @relation("OzonPublisherParitySubjectReviewer")
  ozonPublisherParityDecisionsAsActor      OzonPublisherParityDecision[]             @relation("OzonPublisherParityDecisionActor")
  approvedOzonPublisherRolloutGates        OzonPublisherRolloutGate[]                @relation("OzonPublisherRolloutGateApprover")
  revokedOzonPublisherRolloutGates         OzonPublisherRolloutGate[]                @relation("OzonPublisherRolloutGateRevoker")
  ozonPublisherRolloutEvaluations          OzonPublisherRolloutEvaluation[]          @relation("OzonPublisherRolloutEvaluationActor")
  ozonPublisherRolloutTransitions          OzonPublisherRolloutTransition[]          @relation("OzonPublisherRolloutTransitionActor")
  ozonPublisherRolloutStageTransitions     OzonPublisherRolloutStageTransition[]     @relation("OzonPublisherRolloutStageTransitionActor")
  requestedLogisticsCaptureTasks           LogisticsCaptureTask[]                    @relation("CaptureTaskRequester")
  tenantLogisticsCaptureTasks              LogisticsCaptureTask[]                    @relation("CaptureTaskTenant")
  tenantLogisticsCaptureCandidates         LogisticsCaptureCandidate[]               @relation("CaptureCandidateTenant")
  reviewedLogisticsCaptureCandidates       LogisticsCaptureCandidate[]               @relation("CaptureCandidateReviewer")
  reviewedOfficialInputUnitContracts       LogisticsOfficialInputUnitContract[]      @relation("OfficialInputUnitContractReviewer")
  revokedOfficialInputUnitContracts        LogisticsOfficialInputUnitContract[]      @relation("OfficialInputUnitContractRevoker")

  @@index([parentId])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  userAgent String?  @map("user_agent")
  ip        String?
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model LegalAcceptance {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profile        String
  termsVersion   String   @map("terms_version")
  privacyVersion String   @map("privacy_version")
  source         String
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")
  acceptedAt     DateTime @default(now()) @map("accepted_at")

  @@index([userId])
  @@index([profile])
  @@index([acceptedAt])
  @@map("legal_acceptances")
}

model Shop {
  id                 String     @id @default(cuid())
  userId             String     @map("user_id")
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform           Platform
  name               String
  clientId           String?    @map("client_id")
  apiKeyEncrypted    String     @map("api_key_encrypted")
  apiSecretEncrypted String?    @map("api_secret_encrypted")
  status             ShopStatus @default(ACTIVE)
  balance            Decimal    @default(0) @db.Decimal(12, 2)
  lastSyncAt         DateTime?  @map("last_sync_at")
  errorMessage       String?    @map("error_message")
  config             Json?
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  products                           Product[]
  orders                             Order[]
  warehouses                         Warehouse[]
  syncJobs                           SyncJob[]
  returns                            Return[]
  issues                             ExpressIssue[]
  financeTransactions                OzonFinanceTransaction[]
  ozonCategoryCatalogs               OzonCategoryCatalog[]
  ozonCategoryCatalogSnapshots       OzonCategoryCatalogSnapshot[]
  ozonAttributeDefinitionCaches      OzonAttributeDefinitionCache[]
  logisticsRuleChannels              LogisticsRuleChannel[]                    @relation("LogisticsChannelShop")
  logisticsRuleAssignments           LogisticsRuleAssignment[]                 @relation("LogisticsAssignmentShop")
  shopOzonCompanyBindings            ShopOzonCompanyBinding[]                  @relation("ShopCompanyBindingShop")
  warehouseOzonOriginBindings        WarehouseOzonOriginBinding[]              @relation("WarehouseOriginBindingShop")
  deliveryMethodRuleBindings         ShopDeliveryMethodRuleBinding[]           @relation("MethodRuleBindingShop")
  officialFormulaResolutions         OfficialSellerFormulaResolution[]         @relation("OfficialResolutionShop")
  extensionDeviceGrants              ExtensionDeviceShopGrant[]
  extensionAssignmentGrants          ExtensionDeviceAssignmentGrant[]
  extensionCommandGrants             ExtensionCommandGrant[]
  logisticsCaptureTasks              LogisticsCaptureTask[]                    @relation("CaptureTaskShop")
  logisticsCaptureCandidates         LogisticsCaptureCandidate[]               @relation("CaptureCandidateShop")
  sourceListingWorkflows             SourceListingWorkflow[]
  sourceListingPublishIntents        SourceListingPublishIntent[]
  ozonPublishAttempts                OzonPublishAttempt[]
  extensionByokMediaProvenance       ExtensionByokMediaProvenance[]
  extensionHostedListingAssignments  ExtensionHostedAiImageListingAssignment[]
  extensionAiImageExecutionModeLocks ExtensionAiImageExecutionModeLock[]       @relation("ExtensionAiImageExecutionModeLockShop")
  extensionByokExecutionIntents      ExtensionByokExecutionIntent[]
  extensionByokExecutionBatches      ExtensionByokExecutionBatch[]

  @@unique([id, userId])
  @@index([userId])
  @@index([platform])
  @@map("shops")
}

model Warehouse {
  id                  String   @id @default(cuid())
  shopId              String   @map("shop_id")
  shop                Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  platformWarehouseId String?  @map("platform_warehouse_id")
  name                String
  type                String?
  status              String?
  phone               String?
  // 结构化地址（用户私有）
  countryCode         String?  @map("country_code")
  city                String?
  street              String?
  zipCode             String?  @map("zip_code")
  building            String?
  block               String?
  latitude            Float?
  longitude           Float?
  firstMileType       String?  @map("first_mile_type")
  dropOffPointId      String?  @map("drop_off_point_id")
  dropOffTimeslotId   Int?     @map("drop_off_timeslot_id")
  cutInTime           Int?     @map("cut_in_time")
  isKgt               Boolean  @default(false) @map("is_kgt")
  isRfbs              Boolean  @default(false) @map("is_rfbs")
  workingDays         Json?    @map("working_days")
  warehouseOptions    Json?    @map("warehouse_options")
  // 应用的模板 ID（用户从模板继承标准参数）
  templateId          String?  @map("template_id")
  // 退货设置（用户私有）
  returnRecipient     String?  @map("return_recipient")
  returnPhone         String?  @map("return_phone")
  rawData             Json?    @map("raw_data")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  deliveryMethods             ShopDeliveryMethod[]
  logisticsRuleChannels       LogisticsRuleChannel[]            @relation("LogisticsChannelWarehouse")
  logisticsRuleAssignments    LogisticsRuleAssignment[]         @relation("LogisticsAssignmentWarehouse")
  warehouseOzonOriginBindings WarehouseOzonOriginBinding[]      @relation("WarehouseOriginBindingWarehouse")
  deliveryMethodRuleBindings  ShopDeliveryMethodRuleBinding[]   @relation("MethodRuleBindingWarehouse")
  officialFormulaResolutions  OfficialSellerFormulaResolution[] @relation("OfficialResolutionWarehouse")
  logisticsCaptureTasks       LogisticsCaptureTask[]            @relation("CaptureTaskWarehouse")
  logisticsCaptureCandidates  LogisticsCaptureCandidate[]       @relation("CaptureCandidateWarehouse")

  @@unique([id, shopId])
  @@unique([shopId, platformWarehouseId])
  @@index([shopId])
  @@map("warehouses")
}

model ShopDeliveryMethod {
  id                  String                          @id @default(cuid())
  warehouseId         String                          @map("warehouse_id")
  warehouse           Warehouse                       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  platformMethodId    Int                             @map("platform_method_id")
  name                String
  status              String?
  providerId          Int?                            @map("provider_id")
  providerName        String?                         @map("provider_name")
  tplDropoffPointId   String?                         @map("tpl_dropoff_point_id")
  cutoff              String?
  slaCutIn            Int?                            @map("sla_cut_in")
  tplIntegrationType  String?                         @map("tpl_integration_type")
  dropOffPointAddress String?                         @map("drop_off_point_address")
  dropOffPointName    String?                         @map("drop_off_point_name")
  rawData             Json?                           @map("raw_data")
  createdAt           DateTime                        @default(now()) @map("created_at")
  updatedAt           DateTime                        @updatedAt @map("updated_at")
  ruleBindings        ShopDeliveryMethodRuleBinding[]

  @@unique([id, warehouseId])
  @@unique([warehouseId, platformMethodId])
  @@index([warehouseId])
  @@map("shop_delivery_methods")
}

model Product {
  id                String    @id @default(cuid())
  shopId            String    @map("shop_id")
  shop              Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  platformProductId String?   @map("platform_product_id")
  sku               String?
  offerId           String?   @map("offer_id")
  title             String
  description       String?
  categoryId        String?   @map("category_id")
  price             Decimal?  @db.Decimal(12, 2)
  oldPrice          Decimal?  @map("old_price") @db.Decimal(12, 2)
  currency          String    @default("CNY")
  stock             Int       @default(0)
  weight            Int?
  images            Json?
  attributes        Json?
  variants          Json?
  modelId           String?   @map("model_id")
  status            String?
  visibility        String?
  syncStatus        String?   @map("sync_status")
  commissionRate    Decimal?  @map("commission_rate") @db.Decimal(5, 2)
  minPrice          Decimal?  @map("min_price") @db.Decimal(12, 2)
  ozonCreatedAt     DateTime? @map("ozon_created_at")
  ozonUpdatedAt     DateTime? @map("ozon_updated_at")
  lastOzonSyncAt    DateTime? @map("last_ozon_sync_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([shopId, platformProductId])
  @@unique([shopId, offerId])
  @@index([shopId])
  @@index([sku])
  @@index([modelId])
  @@index([shopId, status, updatedAt])
  @@index([shopId, updatedAt])
  @@index([shopId, ozonCreatedAt])
  @@index([shopId, visibility, syncStatus])
  @@map("products")
}

model Order {
  id              String    @id @default(cuid())
  shopId          String    @map("shop_id")
  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  platformOrderId String    @map("platform_order_id")
  postingNumber   String?   @map("posting_number")
  status          String
  subStatus       String?   @map("sub_status")
  totalAmount     Decimal?  @map("total_amount") @db.Decimal(12, 2)
  currency        String    @default("CNY")
  buyerInfo       Json?     @map("buyer_info")
  shippingInfo    Json?     @map("shipping_info")
  items           Json?
  trackingNumber  String?   @map("tracking_number")
  shippingMethod  String?   @map("shipping_method")
  warehouseId     String?   @map("warehouse_id")
  inProcessAt     DateTime? @map("in_process_at")
  shipmentDate    DateTime? @map("shipment_date")
  deliveringDate  DateTime? @map("delivering_date")
  deliveredAt     DateTime? @map("delivered_at")

  // 国内物流
  domesticTrackingNumber String? @map("domestic_tracking_number")
  domesticCarrier        String? @map("domestic_carrier")
  domesticStatus         String? @default("pending") @map("domestic_status")

  // 国际物流
  internationalTrackingNumber String? @map("international_tracking_number")
  internationalCarrier        String? @map("international_carrier")
  internationalStatus         String? @default("pending") @map("international_status")

  // 采购信息
  purchaseOrderId  String?  @map("purchase_order_id")
  purchasePlatform String?  @map("purchase_platform")
  purchaseAmount   Decimal? @map("purchase_amount") @db.Decimal(12, 2)

  // 服务标签
  serviceTags      Json?    @map("service_tags")
  serviceFee       Decimal? @map("service_fee") @db.Decimal(10, 2)
  shippingFee      Decimal? @map("shipping_fee") @db.Decimal(10, 2)
  feeDeducted      Boolean  @default(false) @map("fee_deducted")
  inspectionStatus String?  @map("inspection_status")
  inspectionPhotos Json?    @map("inspection_photos")
  inspectionNote   String?  @map("inspection_note")

  // SoloSeller 计费 + 个人颜色
  soloFee         Decimal?  @map("solo_fee") @db.Decimal(10, 2)
  soloFeeBilledAt DateTime? @map("solo_fee_billed_at")
  userColorTags   Json?     @map("user_color_tags")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  warehouseLogs  WarehouseLog[]
  trackingEvents OrderTrackingEvent[]

  @@unique([shopId, platformOrderId])
  @@index([shopId])
  @@index([status])
  @@index([postingNumber])
  @@index([domesticTrackingNumber])
  @@index([internationalTrackingNumber])
  @@index([shopId, status, createdAt])
  @@index([shopId, createdAt])
  @@map("orders")
}

