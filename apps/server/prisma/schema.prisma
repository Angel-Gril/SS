  orderNo         String    @unique @map("order_no")
  amount          Decimal   @db.Decimal(10, 2)
  fee             Decimal   @default(0) @db.Decimal(10, 2)
  actualAmount    Decimal   @map("actual_amount") @db.Decimal(10, 2)
  paymentMethod   String    @map("payment_method")
  paymentType     String    @map("payment_type")
  platformOrderNo String?   @map("platform_order_no")
  status          String    @default("pending")
  payUrl          String?   @map("pay_url")
  qrcodeUrl       String?   @map("qrcode_url")
  proofImage      String?   @map("proof_image")
  proofNote       String?   @map("proof_note")
  reviewerId      String?   @map("reviewer_id")
  reviewer        User?     @relation("RechargeOrderReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  reviewedAt      DateTime? @map("reviewed_at")
