// 充值订单：自动易支付和人工收款码统一记录
model RechargeOrder {
  id             String               @id @default(cuid())
  userId         String               @map("user_id")
  user           User                 @relation("RechargeOrderUser", fields: [userId], references: [id], onDelete: Cascade)
  providerId     String               @map("provider_id")
  provider       PaymentProvider      @relation(fields: [providerId], references: [id], onDelete: Restrict)
  manualQrCodeId String?              @map("manual_qr_code_id")
