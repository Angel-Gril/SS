// 汇率：每日一条，源币 -> CNY
model ExchangeRate {
  date         DateTime @db.Date
  fromCurrency String   @map("from_currency")
  toCurrency   String   @default("CNY") @map("to_currency")
  rate         Decimal  @db.Decimal(12, 6)
  source       String   @default("manual")
  fetchedAt    DateTime @default(now()) @map("fetched_at")

  @@id([date, fromCurrency, toCurrency])
  @@index([fromCurrency, date])
  @@map("exchange_rates")
}

// OZON 平台财务流水（按 transaction 拉，operation_type 分类，永久保留）
model OzonFinanceTransaction {
  id                String   @id @default(cuid())
  shopId            String   @map("shop_id")
  shop              Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  operationId       String   @map("operation_id")
  operationType     String   @map("operation_type")
  operationTypeName String?  @map("operation_type_name")
  category          String
  postingNumber     String?  @map("posting_number")
  orderId           String?  @map("order_id")
  amount            Decimal  @db.Decimal(14, 2)
  currency          String
  amountCny         Decimal  @db.Decimal(14, 2) @map("amount_cny")
  exchangeRate      Decimal  @db.Decimal(12, 6) @map("exchange_rate")
  operationDate     DateTime @map("operation_date")
  raw               Json
  createdAt         DateTime @default(now()) @map("created_at")

  @@unique([shopId, operationId])
  @@index([shopId, operationDate])
  @@index([category, operationDate])
  @@index([orderId])
  @@index([postingNumber])
  @@map("ozon_finance_transactions")
}

// 订单成本快照（订单级，永久保留，结算后冻结）
model OrderCostSnapshot {
