[Unit]
Description=SS ERP API Server
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/ss-erp/current/apps/server
Environment=NODE_ENV=production
Environment=SERVER_HOST=127.0.0.1
Environment=RUN_WORKERS=0
EnvironmentFile=/opt/ss-erp/shared/.env.staging
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ss-erp/shared/uploads /opt/ss-erp/shared/watermarked /opt/ss-erp/shared/resized /opt/ss-erp/shared/tmp /opt/ss-erp/shared/backups /opt/ss-erp/current/apps/server/public

[Install]
WantedBy=multi-user.target
