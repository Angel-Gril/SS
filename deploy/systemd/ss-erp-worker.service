[Unit]
Description=SS ERP Background Workers (BullMQ)
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/ss-erp/apps/server
Environment=NODE_ENV=production
EnvironmentFile=/opt/ss-erp/.env.staging
ExecStart=/usr/bin/node dist/worker.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=45

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ss-erp.runtime/uploads /opt/ss-erp.runtime/watermarked /opt/ss-erp.runtime/resized /opt/ss-erp.runtime/public-tmp /opt/ss-erp.runtime/backups /opt/ss-erp/apps/server/public

[Install]
WantedBy=multi-user.target
