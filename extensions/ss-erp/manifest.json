{
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "name": "SS ERP - 松鼠跨境卖家助手",
  "short_name": "SS ERP",
  "version": "1.0.264",
  "description": "OZON跨境电商利润计算、物流同步、商品采集、ERP对接一站式工具",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "cookies",
    "alarms"
  ],
  "host_permissions": [
    "file:///*",
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "https://docs.ozon.ru/*",
    "https://docs.ozon.com/*",
    "https://open.er-api.com/*",
    "https://seller.ozon.ru/*",
    "https://*.ozon.ru/*",
    "https://*.ozon.kz/*",
    "https://*.ozon.by/*",
    "https://globalcalculator.ozon.ru/*",
    "https://ss-erp.com/*",
    "https://*.ss-erp.com/*",
    "https://ss-erp.cn/*",
    "https://*.ss-erp.cn/*",
    "https://s.1688.com/*",
    "https://*.1688.com/*",
    "https://detail.1688.com/*",
    "https://trade.1688.com/*",
    "https://pifa.pinduoduo.com/*",
    "https://mobile.pinduoduo.com/*",
    "https://*.pinduoduo.com/*",
    "https://*.yangkeduo.com/*",
    "https://www.temu.com/*",
    "https://*.aliexpress.com/*",
    "https://www.wildberries.ru/*",
    "https://item.jd.com/*",
    "https://www.taobao.com/*",
    "https://s.taobao.com/*",
    "https://item.taobao.com/*",
    "https://detail.tmall.com/*",
    "https://www.goofish.com/*",
    "https://goofish.com/*",
    "https://2.taobao.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "https://localhost/*",
      "http://127.0.0.1/*",
      "https://127.0.0.1/*",
      "https://ss-erp.com/*",
      "https://*.ss-erp.com/*",
      "https://ss-erp.cn/*",
      "https://*.ss-erp.cn/*",
      "https://staging.ss-erp.com/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://mobile.yangkeduo.com/goods.html*",
        "https://item.taobao.com/item.htm*",
        "https://detail.tmall.com/item.htm*"
      ],
      "js": [
        "shared/collectors/pdd-network-normalizer.js",
        "shared/collectors/taobao-network-normalizer.js",
        "content/source-network-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://seller.ozon.ru/*",
        "https://globalcalculator.ozon.ru/*"
      ],
      "js": [
        "content/capture-network-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://seller.ozon.ru/*"
      ],
      "js": [
        "content/ozon-premium-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.ozon.ru/*",
        "https://*.ozon.kz/*",
        "https://*.ozon.by/*"
      ],
      "js": [
        "shared/calculator-core/profit-engine.js",
        "shared/calculator-core/rule-engine.js",
        "shared/logistics-rules/version-policy.js",
        "shared/commission/commission-rates.js",
        "shared/currency/fx-rates.js",
        "shared/ozon/page-product.js",
        "shared/seller-products/seller-products-export.js",
        "shared/official-freight/official-freight-export.js",
        "shared/seller-logistics/seller-logistics-export.js",
        "shared/erp-package/erp-package-export.js",
        "shared/erp-package/erp-package-summary.js",
        "shared/config-bridge/sync-schema.js",
        "shared/logistics-rules/distribution-feature.js",
        "shared/config-bridge/config-store.js",
        "shared/erp-adapter/index.js",
        "shared/erp-adapter/collect-product.js",
        "content/ozon-panel.js",
        "content/ozon-injector.js"
      ],
      "css": [
        "content/ozon-panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://detail.1688.com/*",
        "https://*.pinduoduo.com/*",
        "https://*.yangkeduo.com/*",
        "https://www.temu.com/*",
        "https://*.aliexpress.com/*",
        "https://www.wildberries.ru/*",
        "https://ozon.ru/product/*",
        "https://www.ozon.ru/product/*",
        "https://ozon.kz/product/*",
        "https://www.ozon.kz/product/*",
        "https://ozon.by/product/*",
        "https://www.ozon.by/product/*",
        "https://item.jd.com/*",
        "https://item.taobao.com/*",
        "https://detail.tmall.com/*",
        "https://www.goofish.com/*",
        "https://goofish.com/*",
        "https://2.taobao.com/*"
      ],
      "js": [
        "shared/currency/price-currency.js",
        "shared/contracts/source-product-capture-v2.js",
        "shared/collectors/1688-dom-fallback.js",
        "shared/collectors/source-product-core.js",
        "shared/collectors/pdd-product.js",
        "shared/collectors/pdd-network-normalizer.js",
        "shared/collectors/taobao-network-normalizer.js",
        "shared/collectors/marketplace-product.js",
        "shared/ozon/variant-spec.js",
        "shared/ozon/sku-workbench.js",
        "content/collect-content-script.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://detail.1688.com/*",
        "https://*.pinduoduo.com/*",
        "https://*.yangkeduo.com/*",
        "https://item.taobao.com/*",
        "https://detail.tmall.com/*",
        "https://www.goofish.com/*",
        "https://goofish.com/*",
        "https://2.taobao.com/*"
      ],
      "js": [
        "shared/calculator-core/profit-engine.js",
        "shared/calculator-core/rule-engine.js",
        "shared/commission/commission-rates.js",
        "shared/currency/fx-rates.js",
        "shared/source-costing/panel-core.js",
        "shared/source-costing/ai-image-suite-controller.js",
        "shared/source-costing/ai-workbench-launch-context.js",
        "content/source-listing-workbench.js",
        "content/source-costing-panel.js"
      ],
      "css": [
        "content/source-listing-workbench.css",
        "content/source-costing-panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://s.1688.com/*",
        "https://*.1688.com/*"
      ],
      "js": [
        "content/source-search-1688.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pifa.pinduoduo.com/*"
      ],
      "js": [
        "content/source-search-pdd.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.taobao.com/*",
        "https://s.taobao.com/*"
      ],
      "js": [
        "content/source-search-taobao.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.ozon.ru/*",
        "https://www.ozon.kz/*",
        "https://www.ozon.by/*"
      ],
      "exclude_matches": [
        "https://*.ozon.ru/product/*",
        "https://*.ozon.kz/product/*",
        "https://*.ozon.by/product/*"
      ],
      "js": [
        "shared/currency/price-currency.js",
        "content/ozon-list-overlay.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://trade.1688.com/*",
        "https://mobile.pinduoduo.com/*"
      ],
      "js": [
        "content/logistics-bridge.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "https://ss-erp.com/*",
        "https://*.ss-erp.com/*",
        "https://ss-erp.cn/*",
        "https://*.ss-erp.cn/*"
      ],
      "js": [
        "shared/erp-adapter/deployment-defaults.js",
        "content/erp-collect-bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "content/capture-page-hook.js",
        "content/page-bridge.js",
        "content/source-search-1688-page.js",
        "content/source-search-pdd-page.js",
        "content/source-search-taobao-page.js",
        "shared/capture-bridge/captured-har-store.js",
        "shared/seller-products/seller-products-export.js",
        "shared/official-freight/official-freight-export.js",
        "shared/seller-logistics/seller-logistics-export.js",
        "shared/erp-package/erp-package-export.js",
        "shared/erp-package/erp-package-summary.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "SS ERP",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "pages/settings.html"
}
