{
  "name": "ss-erp",
  "version": "0.1.0",
  "private": true,
  "description": "松鼠跨境 ERP - 跨境电商多平台 SaaS 管理系统",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:studio": "pnpm --filter server db:studio",
    "db:seed": "pnpm --filter server db:seed",
    "build:extension:cloud": "node scripts/build-extension-package.mjs cloud",
    "build:extension:local": "node scripts/build-extension-package.mjs local",
    "verify:extension": "node scripts/verify-extension-package.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=20.0.0"
  }
}
