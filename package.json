{
  "name": "ss-erp",
  "version": "0.1.0",
  "private": true,
  "description": "松鼠跨境 ERP - 跨境电商多平台 SaaS 管理系统",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:studio": "pnpm --filter server db:studio",
    "db:seed": "pnpm --filter server db:seed",
    "preflight": "node scripts/preflight.mjs",
    "qa:04:offline": "node scripts/qa04-offline-gate.mjs",
    "qa:04:offline:list": "node scripts/qa04-offline-gate.mjs --list",
    "test:qa04:offline-contract": "node scripts/qa04-offline-gate-contract.test.mjs",
    "env:check": "node scripts/validate-env.mjs",
    "diagnose:redis": "bash scripts/diagnose-redis-runtime.sh",
    "smoke:remote": "pnpm --filter server smoke:remote",
    "generate:source-capture-contract": "node scripts/generate-source-capture-contract.mjs",
    "check:source-capture-contract": "node scripts/generate-source-capture-contract.mjs --check",
    "build:extension:cloud": "node scripts/build-extension-package.mjs cloud && pnpm verify:extension:cloud",
    "build:extension:local": "node scripts/build-extension-package.mjs local && pnpm verify:extension:local",
    "package:extension": "node scripts/package-extension-release.mjs",
    "package:extension:cloud": "node scripts/package-extension-package.mjs cloud",
    "package:extension:local": "node scripts/package-extension-package.mjs local",
    "create:extension-release-key": "node scripts/create-extension-release-signing-key.mjs",
    "sign:extension-release": "node scripts/sign-extension-release.mjs",
    "sign:extension-website-publication": "node scripts/sign-extension-website-publication.mjs",
    "activate:extension-website-publication": "node scripts/activate-extension-website-publication.mjs",
    "probe:extension-release-website": "node scripts/probe-extension-website-distribution.mjs",
    "verify:extension-publication": "node scripts/verify-extension-publication.mjs",
    "test:extension-release-publication": "node scripts/extension-release-publication.test.mjs",
    "test:extension-website-publication-gate": "node --test scripts/extension-website-publication-gate.test.mjs",
    "canary:rel04:dark": "node scripts/rel04-dark-canary.mjs",
    "test:rel04:dark-canary": "node scripts/rel04-dark-canary.test.mjs",
    "verify:extension": "node scripts/verify-extension-package.mjs",
    "verify:extension:cloud": "node scripts/verify-extension-package.mjs --dir build/extensions/ss-erp-cloud --target cloud --strict",
    "verify:extension:local": "node scripts/verify-extension-package.mjs --dir build/extensions/ss-erp-local --target local",
    "attest:extension:active-worker": "node scripts/extension-active-worker-attestation.mjs",
    "diagnose:extension:managed": "node scripts/extension-managed-install-diagnostics.mjs",
    "launch:extension:cdp": "node scripts/launch-extension-cdp.mjs",
    "smoke:extension:live-sw-unicode": "node scripts/extension-live-sw-unicode-smoke.mjs",
    "test:extension-live-sw-unicode-smoke": "node --test scripts/extension-live-sw-unicode-smoke.test.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.9.0",
    "ajv": "^8.20.0",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "json-schema-to-typescript": "^15.0.4",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.60.0"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.19.0"
  }
}
