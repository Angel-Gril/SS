# SS ERP 数据库备份 cron 配置示例
# 安装方式：
#   1. 创建环境变量文件 /etc/ss-erp-backup.env（参考下方内容）
#      并执行：sudo chown root:root /etc/ss-erp-backup.env && sudo chmod 0600 /etc/ss-erp-backup.env
#   2. 创建目录：sudo mkdir -p /var/backups/ss-erp /var/log/ss-erp
#   3. 将下面的 cron 行加入 root crontab：sudo crontab -e
#
# ─── /etc/ss-erp-backup.env ───
# BACKUP_DB_URL="postgresql://ss_erp_user:password@localhost:5432/ss_erp"
# BACKUP_DB_URL and the app URL must resolve to the same database name/OID and canonical
# stored deployment identity JSON (DEPLOY_DATABASE_ID + deployment UUID).
# DEPLOY_DATABASE_ID="production-primary"
# BACKUP_DEPLOYED_COMMIT_FILE="/opt/ss-erp/current/DEPLOYED_COMMIT"
# DEPLOY_BACKUP_MAX_AGE_MINUTES="120"
# DEPLOY_BACKUP_VERIFY_TIMEOUT="20m"
# BACKUP_LOCAL_DIR="/var/backups/ss-erp"
# BACKUP_LOCAL_DIR must equal the app DEPLOY_BACKUP_LOCAL_DIR and be owned by the backup user;
# it must not be group/world writable or shared with the application backup worker.
# BACKUP_KEEP_DAYS="7"
# BACKUP_S3_BUCKET="ss-erp-backup"
# BACKUP_S3_ENDPOINT="https://oss-cn-hangzhou.aliyuncs.com"
# BACKUP_S3_ACCESS_KEY_ID="LTAI..."
# BACKUP_S3_SECRET_ACCESS_KEY="..."
# BACKUP_S3_PREFIX="db/"
# BACKUP_S3_REGION="oss-cn-hangzhou"

# ─── crontab 行 ───
# 每天凌晨 3:00 执行备份（按服务器本地时区）
0 3 * * * set -a; . /etc/ss-erp-backup.env; set +a; BACKUP_DEPLOYED_COMMIT_FILE=/opt/ss-erp/current/DEPLOYED_COMMIT bash /opt/ss-erp/current/scripts/backup-db.sh >> /var/log/ss-erp/backup.log 2>&1

# 每周日 4:00 额外做一次全量备份（可选，用于异地冗余）
# 0 4 * * 0 set -a; . /etc/ss-erp-backup.env; set +a; BACKUP_DEPLOYED_COMMIT_FILE=/opt/ss-erp/current/DEPLOYED_COMMIT bash /opt/ss-erp/current/scripts/backup-db.sh >> /var/log/ss-erp/backup-weekly.log 2>&1
