{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ss-erp.local/schemas/ai-media-evaluation-policy-v1.json",
  "title": "AI Media Evaluation Threshold Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "status",
    "description",
    "containsSecrets",
    "metric",
    "manualReview",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*-v[1-9][0-9]*$" },
    "kind": { "const": "evaluation-threshold-policy" },
    "status": { "const": "policy_only" },
    "description": { "type": "string", "minLength": 20 },
    "containsSecrets": { "const": false },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "unit", "direction", "validRange", "threshold"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "unit": { "enum": ["score", "ratio"] },
        "direction": { "enum": ["higher_is_better", "lower_is_better"] },
        "validRange": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": { "type": "number" },
            "maximum": { "type": "number" }
          }
        },
        "threshold": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operator", "value"],
          "properties": {
            "operator": { "enum": ["gte", "lte"] },
            "value": { "type": "number" }
          }
        }
      }
    },
    "manualReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "instructions"],
      "properties": {
        "required": { "const": true },
        "instructions": { "type": "string", "minLength": 20 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpusAvailable", "qualityMeasured", "note"],
      "properties": {
        "corpusAvailable": { "const": false },
        "qualityMeasured": { "const": false },
        "note": { "type": "string", "minLength": 20 }
      }
    }
  }
}
