{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ss-erp.local/contracts/source-taobao-network-fixture-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixtureVersion",
    "id",
    "platform",
    "responseSignature",
    "capturedAt",
    "pageIdentity",
    "priceSemantics",
    "responseBody",
    "sanitization",
    "expected"
  ],
  "properties": {
    "fixtureVersion": { "const": "source-marketplace-network-fixture/v1" },
    "id": { "type": "string", "minLength": 3, "maxLength": 120 },
    "platform": { "const": "taobao" },
    "responseSignature": { "type": "string", "minLength": 3, "maxLength": 120 },
    "capturedAt": {
      "type": "string",
      "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "pageIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["productId", "canonicalUrl"],
      "properties": {
        "productId": { "type": "string", "pattern": "^[0-9]{4,32}$" },
        "canonicalUrl": {
          "type": "string",
          "pattern": "^https://item\\.(taobao|tmall)\\.com/item\\.htm\\?id=[0-9]{4,32}$"
        }
      }
    },
    "priceSemantics": { "const": "decimal_cny" },
    "responseBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item", "skuBase", "skuCore"],
      "properties": {
        "item": {
          "type": "object",
          "additionalProperties": false,
          "required": ["itemId", "title", "images"],
          "properties": {
            "itemId": { "type": "string", "pattern": "^[0-9]{4,32}$" },
            "title": { "type": "string", "minLength": 1, "maxLength": 500 },
            "images": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "items": { "type": "string", "pattern": "^https://" }
            }
          }
        },
        "skuBase": {
          "type": "object",
          "additionalProperties": false,
          "required": ["skus"],
          "properties": {
            "skus": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["skuId", "propPath"],
                "properties": {
                  "skuId": { "type": "string", "minLength": 1, "maxLength": 80 },
                  "propPath": { "type": "string", "minLength": 1, "maxLength": 500 }
                }
              }
            }
          }
        },
        "skuCore": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sku2info"],
          "properties": {
            "sku2info": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 500,
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["price"],
                "properties": {
                  "price": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["priceText"],
                    "properties": {
                      "priceText": { "type": "string", "pattern": "^[0-9]+(\\.[0-9]{1,2})?$" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "sanitization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["containsSecrets", "removedPaths"],
      "properties": {
        "containsSecrets": { "const": false },
        "removedPaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "maxItems": 100
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "rejectionCodes"],
      "properties": {
        "decision": { "enum": ["accept", "reject"] },
        "rejectionCodes": {
          "type": "array",
          "items": {
            "enum": [
              "SIGNATURE_NOT_ALLOWED",
              "IDENTITY_MISMATCH",
              "INVALID_PRODUCT",
              "INVALID_SKU",
              "INVALID_PRICE",
              "SENSITIVE_DATA"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  }
}
